    "test": "pnpm --filter click-wheel test && pnpm --filter website test",
    "build:package": "pnpm --filter click-wheel build"
  },
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.8"
  }
}
