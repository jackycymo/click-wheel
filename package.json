{
  "name": "click-wheel-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "dev": "cd website && bun run dev",
    "build": "cd website && bun run build",
    "lint": "eslint website/src packages/click-wheel/src/web",
    "check": "cd packages/click-wheel && bun run check",
    "test": "cd packages/click-wheel && bun run test"
  }
}
