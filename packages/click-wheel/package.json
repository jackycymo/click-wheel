    "check": "tsc -p tsconfig.web.json && tsc -p tsconfig.tests.json",
    "test": "bun test --preload ./tests/setup.ts ./tests"
  },
  "peerDependencies": {
    "react": ">=19.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "20.14.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5"
  }
}
