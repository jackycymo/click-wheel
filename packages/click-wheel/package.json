{
  "name": "click-wheel",
  "version": "0.1.0",
  "description": "The iPod click wheel for React and React Native. Unstyled parts, gearing instead of length, detents, haptics, inertia.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/web/index.ts",
    "./native": "./src/native/index.ts",
    "./core": "./src/core.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.web.json && tsc -p tsconfig.native.json"
  },
  "peerDependencies": {
    "expo-haptics": ">=14",
    "react": ">=19",
    "react-native": ">=0.76",
    "react-native-gesture-handler": ">=3",
    "react-native-reanimated": ">=3.16"
  },
  "peerDependenciesMeta": {
    "expo-haptics": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "expo-haptics": "^57.0.3",
    "react": "19.2.4",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.7.0",
    "react-native-worklets": "^0.12.2",
    "typescript": "^5"
  }
}
