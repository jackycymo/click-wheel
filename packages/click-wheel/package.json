{
  "name": "click-wheel",
  "version": "0.1.0",
  "description": "The iPod click wheel for React. Unstyled parts, gearing instead of length, detents, haptics, inertia.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "default": "./dist/web/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.web.json && tsc -p tsconfig.tests.json",
    "test": "bun test --preload ./tests/setup.ts ./tests",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check && pnpm run test"
  },
  "peerDependencies": {
    "react": ">=19.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "20.14.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackycymo/click-wheel.git",
    "directory": "packages/click-wheel"
  },
  "homepage": "https://click-wheel.jackymo.me",
  "bugs": {
    "url": "https://github.com/jackycymo/click-wheel/issues"
  },
  "keywords": [
    "react",
    "click-wheel",
    "rotary",
    "slider",
    "headless",
    "haptics"
  ],
  "main": "./dist/web/index.js",
  "types": "./dist/web/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
